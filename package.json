{
  "name": "kansetsu-koyomi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync-public.mjs && next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:py": "python -m pytest -q",
    "palette": "node scripts/validate-palette.mjs",
    "smoke": "node harness/smoke.mjs",
    "hygiene": "python harness/text_hygiene.py",
    "data": "cd etl && python fetch.py && python build.py",
    "data:latest": "cd etl && python fetch.py --latest-only && python build.py",
    "verify": "npm run typecheck && npm run test && npm run test:py && npm run build && npm run smoke",
    "live": "node harness/live.mjs"
  },
  "dependencies": {
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
